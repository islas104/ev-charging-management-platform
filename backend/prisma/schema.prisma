generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id            Int       @id @default(autoincrement())
  name          String
  type          AccountType @default(OWNER)
  email         String?
  vatNumber     String?
  invoiceEmail  String?
  alertEmail    String?
  bankName      String?
  bankIban      String?
  bankBic       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admins        AdminUser[]
  locations     Location[]
  drivers       Driver[]
  operatorConnections ConnectedAccount[] @relation("OperatorAccount")
  ownerConnections    ConnectedAccount[] @relation("OwnerAccount")
  operatorLocations   Location[] @relation("OperatorAccountLocations")
  driverGroups        DriverGroup[]
}

model ConnectedAccount {
  id                Int      @id @default(autoincrement())
  operatorAccountId Int
  ownerAccountId    Int
  serviceFeePercent Decimal  @db.Decimal(5, 4)
  createdAt         DateTime @default(now())

  operatorAccount   Account  @relation("OperatorAccount", fields: [operatorAccountId], references: [id])
  ownerAccount      Account  @relation("OwnerAccount", fields: [ownerAccountId], references: [id])

  @@unique([operatorAccountId, ownerAccountId])
}

model Location {
  id              Int       @id @default(autoincrement())
  accountId       Int
  operatorAccountId Int?
  name            String
  address         String
  latitude        Decimal   @db.Decimal(9, 6)
  longitude       Decimal   @db.Decimal(9, 6)
  access          LocationAccess @default(PUBLIC)
  visibility      LocationVisibility @default(LISTED)
  tariffId        Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account         Account   @relation(fields: [accountId], references: [id])
  operatorAccount Account?  @relation("OperatorAccountLocations", fields: [operatorAccountId], references: [id])
  tariff          Tariff?   @relation(fields: [tariffId], references: [id])
  chargers        Charger[]
  qrCodes         QrCode[]
  transactions    Transaction[]
}

model Charger {
  id           Int       @id @default(autoincrement())
  chargerId    String    @unique
  protocol     String
  registered   Boolean   @default(false)
  lastSeenAt   DateTime?

  locationId   Int?
  location     Location? @relation(fields: [locationId], references: [id])

  transactions Transaction[]

  connectors   ConnectorStatus[]
  ocppMessages OcppMessageLog[]
  qrCodes      QrCode[]
  meterValues  MeterValue[]
  remoteCommands RemoteCommand[]

  createdAt    DateTime  @default(now())
}

model ConnectorStatus {
  id            Int      @id @default(autoincrement())
  chargerId     Int
  charger       Charger  @relation(fields: [chargerId], references: [id])

  connectorId   Int      // 1,2,3...
  status        String   // Available, Charging, Faulted, Unavailable, etc.
  errorCode     String?
  vendorError   String?
  info          String?

  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([chargerId, connectorId])
  @@index([chargerId])
  @@index([status])
}

model OcppMessageLog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())

  chargerId   Int
  charger     Charger  @relation(fields: [chargerId], references: [id])

  // "IN" for request from charger, "OUT" for response sent back (or server->charger)
  direction   String

  // BootNotification, Heartbeat, StartTransaction, StopTransaction, MeterValues, Authorize, StatusNotification...
  operation   String

  // OCPP messageId (lets us pair request/response)
  messageId   String?

  // Raw payload stored as JSON
  raw         Json

  // Optional response status (Accepted/Rejected/etc)
  status      String?

  @@index([chargerId, createdAt])
  @@index([operation])
  @@index([messageId])
}

model Transaction {
  id                 Int       @id @default(autoincrement())
  ocppTransactionId  Int       @unique
  chargerId          Int
  charger            Charger   @relation(fields: [chargerId], references: [id])
  idTag              String
  meterStart         Int
  meterStop          Int?
  startedAt          DateTime  @default(now())
  stoppedAt          DateTime?
  stopReason         String?

  locationId         Int?
  location           Location? @relation(fields: [locationId], references: [id])
  driverId           Int?
  driver             Driver?   @relation(fields: [driverId], references: [id])
  driverGroupId      Int?
  driverGroup        DriverGroup? @relation(fields: [driverGroupId], references: [id])

  startFee           Decimal?  @db.Decimal(10, 4)
  energyFee          Decimal?  @db.Decimal(10, 4)
  idleFee            Decimal?  @db.Decimal(10, 4)
  vatRate            Decimal?  @db.Decimal(5, 4)
  currency           String?

  meterValues        MeterValue[]

  totalEnergyKwh     Decimal?  @db.Decimal(12, 4)
  totalIdleMinutes   Int?
  totalCost          Decimal?  @db.Decimal(12, 4)
}

model RemoteCommand {
  id           Int      @id @default(autoincrement())
  chargerId    Int
  command      String
  messageId    String
  payload      Json
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  charger      Charger  @relation(fields: [chargerId], references: [id])

  @@index([chargerId, createdAt])
  @@index([messageId])
}

model MeterValue {
  id                Int      @id @default(autoincrement())
  chargerId         Int
  transactionId     Int?
  ocppTransactionId Int?
  connectorId       Int?
  timestamp         DateTime?
  raw               Json
  createdAt         DateTime @default(now())

  charger           Charger  @relation(fields: [chargerId], references: [id])
  transaction       Transaction? @relation(fields: [transactionId], references: [id])

  @@index([chargerId, createdAt])
  @@index([ocppTransactionId])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime @default(now())

  accountId    Int?
  account      Account? @relation(fields: [accountId], references: [id])
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

// Global pricing configuration (single row used by the platform)
// - baseEnergyGbpKwh: what the CPO earns per kWh (ex VAT)
// - platformMarkup: % markup added on top so driver pays more (0.10 = 10%)
model PricingConfig {
  id              Int      @id @default(autoincrement())
  baseEnergyGbpKwh Decimal  @db.Decimal(10, 4)
  platformMarkup  Decimal  @db.Decimal(5, 4)
  currency        String   @default("GBP")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model Driver {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?   @unique
  accountId Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  fobs      RfidFob[]
  account   Account?  @relation(fields: [accountId], references: [id])
  groups    DriverGroupMember[]
  transactions Transaction[]
}

model RfidFob {
  id        Int      @id @default(autoincrement())
  uid       String   @unique // RFID UID e.g. hex string from reader
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverId  Int?
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([active])
}

model DriverGroup {
  id          Int      @id @default(autoincrement())
  accountId   Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account  @relation(fields: [accountId], references: [id])
  members     DriverGroupMember[]
  tariffs     DriverGroupTariff[]
  transactions Transaction[]

  @@unique([accountId, name])
}

model DriverGroupMember {
  id           Int     @id @default(autoincrement())
  driverId     Int
  driverGroupId Int

  driver       Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverGroup  DriverGroup @relation(fields: [driverGroupId], references: [id], onDelete: Cascade)

  @@unique([driverId, driverGroupId])
  @@index([driverGroupId])
}

model Tariff {
  id        Int      @id @default(autoincrement())
  name      String
  startFee  Decimal  @db.Decimal(10, 4)
  energyFee Decimal  @db.Decimal(10, 4)
  idleFee   Decimal  @db.Decimal(10, 4)
  vatRate   Decimal  @db.Decimal(5, 4)
  currency  String   @default("GBP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]
  driverGroupTariffs DriverGroupTariff[]
}

model DriverGroupTariff {
  id           Int     @id @default(autoincrement())
  driverGroupId Int
  tariffId     Int

  driverGroup  DriverGroup @relation(fields: [driverGroupId], references: [id], onDelete: Cascade)
  tariff       Tariff      @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@unique([driverGroupId, tariffId])
}

model QrCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  active      Boolean  @default(true)
  locationId  Int
  chargerId   Int?
  connectorId Int?
  createdAt   DateTime @default(now())

  location    Location @relation(fields: [locationId], references: [id])
  charger     Charger? @relation(fields: [chargerId], references: [id])
}

enum AccountType {
  OWNER
  OPERATOR
}

enum LocationAccess {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum LocationVisibility {
  LISTED
  UNLISTED
}
