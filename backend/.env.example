NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ev_charging
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500
HTTP_BODY_LIMIT=1mb
THROTTLE_TTL=60
THROTTLE_LIMIT=120
OCPP_SHARED_SECRET=
OCPP_MAX_MESSAGE_BYTES=1000000
OCPP_ALLOW_UNKNOWN_IDTAG=false
JWT_SECRET=change_me_now
JWT_EXPIRES_IN=8h
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me_now
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_RESET_TOKEN_TTL_MIN=30
IDEMPOTENCY_TTL_HOURS=24
REMOTE_COMMAND_TTL_SECONDS=45
SEED_DEFAULTS=true

EASEE_ENABLED=true
EASEE_BASE_URL=https://api.easee.com
EASEE_USERNAME=YOUR_EASEE_EMAIL
EASEE_PASSWORD=YOUR_EASEE_PASSWORD
EASEE_ACCESS_TOKEN=
EASEE_POLL_SECONDS=20
EASEE_CHARGERS_PATH=/api/chargers
EASEE_START_PATH_TEMPLATE=/api/chargers/{chargerId}/commands/start_charging
EASEE_STOP_PATH_TEMPLATE=/api/chargers/{chargerId}/commands/stop_charging
EASEE_DYNAMIC_CURRENT_PATH_TEMPLATE=
EASEE_ACCOUNT_ID=1
EASEE_SITES_PATH=/api/sites
EASEE_SITE_CHARGERS_PATH_TEMPLATE=/api/sites/{siteId}/chargers
EASEE_SITE_DETAIL_PATH_TEMPLATE=
EASEE_DEFAULT_LOCATION_ADDRESS=
EASEE_DEFAULT_LOCATION_LATITUDE=52.4862
EASEE_DEFAULT_LOCATION_LONGITUDE=-1.8904
